--- !u!114 &502715616
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 502715613}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d9542e1c44899943af8d86272ca82ed, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SynopsisManager
  synopsisPanel: {fileID: 415587794}
  pageImage: {fileID: 456314780}
  pageText: {fileID: 1141573451}
  synopsisPages:
  - image: {fileID: -5913128172085433337, guid: 1cbb26760adda4042aa32593d9b728a5, type: 3}
    text: "\uBAA8\uB4E0 \uAC83\uC774 \uBA48\uCD98 \uB4EF \uACE0\uC694\uD558\uB2E4.
      \uACBD\uBCF4\uC74C\uB3C4, \uD3ED\uBC1C\uB3C4 \uC5C6\uC5C8\uB2E4. \uD558\uC9C0\uB9CC
      \uB208\uC55E\uC758 \uD48D\uACBD\uC740 \uB0B4\uAC00 \uC54C\uB358 \uAE30\uC9C0\uAC00
      \uC544\uB2C8\uB2E4.\r\n\r\n"
  - image: {fileID: -5913128172085433337, guid: 1cbb26760adda4042aa32593d9b728a5, type: 3}
    text: "\uBC14\uB2E5\uC774 \uCC9C\uC7A5\uC774 \uB418\uACE0, \uCC9C\uC7A5\uC774
      \uBC14\uB2E5\uC774 \uB41C \uB4A4\uC9D1\uD78C \uC138\uC0C1... \uC911\uB825 \uC81C\uC5B4
      \uC7A5\uCE58\uAC00 \uACE0\uC7A5 \uB098\uBA74\uC11C, \uAE30\uC9C0 \uC804\uCCB4\uAC00
      \uAC70\uB300\uD55C \uD37C\uC990 \uC0C1\uC790\uCC98\uB7FC \uBCC0\uD574\uBC84\uB838\uB2E4."
  - image: {fileID: -4812554304040194306, guid: 4072ce40cdf9dd64f964e07666062847, type: 3}
    text: "\uB098\uB97C \uB9C9\uB294 \uC794\uD574\uB3C4, \uCAD3\uC544\uC624\uB294
      \uB85C\uBD07\uB3C4 \uC5C6\uB2E4. \uC774\uACF3\uC5D0 \uB0A8\uC740 \uAC74 \uC624\uC9C1
      \uC5C9\uB9DD\uC73C\uB85C \uB4A4\uD2C0\uB9B0 \uBB3C\uB9AC \uBC95\uCE59\uACFC
      \uB098, \uB2E8\uB458\uBFD0\uC774\uB2E4."
  - image: {fileID: -795886438020425439, guid: 1daf721879116c14d8781bcaf01654ac, type: 3}
    text: "\uD0C8\uCD9C\uD560 \uBC29\uBC95\uC740 \uD558\uB098. \uC774 \uD63C\uB780\uC2A4\uB7EC\uC6B4
      \uC911\uB825\uC758 \uD750\uB984\uC744 \uC5ED\uC774\uC6A9\uD574 \uB04A\uC5B4\uC9C4
      \uAE38\uC744 \uC787\uB294 \uAC83. \uAE30\uC9C0 \uAE4A\uC219\uD55C \uACF3, \uBE44\uC0C1
      \uD0C8\uCD9C \uB85C\uCF13\uC774 \uC788\uB294 \uACA9\uB0A9\uACE0\uAE4C\uC9C0
      \uAC00\uC57C \uD55C\uB2E4."
  - image: {fileID: -795886438020425439, guid: 1daf721879116c14d8781bcaf01654ac, type: 3}
    text: "\uC0DD\uAC01\uD558\uC790. \uC704\uC640 \uC544\uB798\uB77C\uB294 \uACE0\uC815\uAD00\uB150\uC744
      \uBC84\uB9AC\uC9C0 \uC54A\uC73C\uBA74, \uB09C \uC601\uC6D0\uD788 \uC774 \uB2EC\uC758
      \uAC10\uC625\uC5D0\uC11C \uBE60\uC838\uB098\uAC08 \uC218 \uC5C6\uC744 \uD14C\uB2C8."
  nextLevelSceneName: map1-1
  currentPageIndex: 0
